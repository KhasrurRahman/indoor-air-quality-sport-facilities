\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Air Quality Distributions}{3}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Distribution of AirControl sensor readings across all participants and both locations. CO$_2$ is right-skewed; temperature is approximately normal; humidity shows wide spread.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:aq_dist}{{1}{3}{Distribution of AirControl sensor readings across all participants and both locations. CO$_2$ is right-skewed; temperature is approximately normal; humidity shows wide spread}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Work vs.\ Home: Air Quality and Particulate Matter}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Mean air quality indicators by location type.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:wh}{{1}{4}{Mean air quality indicators by location type}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces CO$_2$, temperature and humidity by location type. CO$_2$ is higher and more variable at work; temperature and humidity are nearly equal across both settings.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:wh_aq}{{2}{4}{CO$_2$, temperature and humidity by location type. CO$_2$ is higher and more variable at work; temperature and humidity are nearly equal across both settings}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Survey Responses by Location}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Survey response distributions by location. Stress is marginally higher at work; other dimensions are largely similar between settings.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:wh_survey}{{3}{5}{Survey response distributions by location. Stress is marginally higher at work; other dimensions are largely similar between settings}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Correlations: Air Quality and Well-being}{5}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Spearman correlation matrix between AirControl air quality variables and survey responses. Most air quality and well-being correlations are weak; the strongest pattern is the tiredness--productivity relationship.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:corr}{{4}{6}{Spearman correlation matrix between AirControl air quality variables and survey responses. Most air quality and well-being correlations are weak; the strongest pattern is the tiredness--productivity relationship}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Temporal Patterns}{6}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Daily trends across the 17-day study period. CO$_2$ is stable over time; survey responses show more variation driven by individual factors.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:temporal}{{5}{7}{Daily trends across the 17-day study period. CO$_2$ is stable over time; survey responses show more variation driven by individual factors}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}CO$_2$ Thresholds and Well-being}{7}{subsection.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Survey responses by CO$_2$ category. Most observations fall in the Low category. Mental demand appears slightly elevated in the High CO$_2$ group, but sample sizes limit conclusions.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:co2cat}{{6}{8}{Survey responses by CO$_2$ category. Most observations fall in the Low category. Mental demand appears slightly elevated in the High CO$_2$ group, but sample sizes limit conclusions}{figure.6}{}}
